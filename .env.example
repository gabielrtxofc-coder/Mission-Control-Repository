# ─────────────────────────────────────────────────────────────
# Mission Control V1 — variáveis de ambiente (exemplo sem segredos)
# Copie para .env e preencha. Nunca commite .env.
# ─────────────────────────────────────────────────────────────

# Conexão PostgreSQL (obrigatório). Aceita qualquer provedor
# compatível (local, Railway, Neon, Supabase gerenciado etc.).
# Para provedores gerenciados, prefira a URL com SSL (sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mission_control?schema=public"

# Banco usado pelos testes de integração (opcional em produção).
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mission_control_test?schema=public"

# Segredo usado para assinar/derivar cookies e tokens internos (obrigatório).
# Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-um-valor-aleatorio-longo"

# Fuso horário da aplicação para cálculo de "hoje", prazos e calendários.
APP_TIMEZONE="America/Sao_Paulo"

# URL pública da aplicação (usada em links de notificação e cookies seguros).
# Em produção: https://seu-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Configuração do primeiro administrador (usada apenas por `npm run setup:admin`).
# Se ADMIN_PASSWORD for omitido, uma senha forte é gerada e impressa uma única vez.
ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD=""

# Caminho raiz para armazenamento de anexos (desenvolvimento/self-hosted).
# Em produção serverless (Vercel) configure um blob storage — ver docs/IMPLANTACAO.md.
UPLOADS_DIR="var/uploads"
